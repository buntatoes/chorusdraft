# ChorusDraft 0.53.2 — Bluesky mode. Review is default; `automatic` is explicit opt-in.
AI_PROVIDER=local
# LOCAL_LLM_URL must be a loopback host (localhost / 127.0.0.1 / ::1), HTTP or HTTPS.
LOCAL_LLM_URL=http://localhost:11434/v1/chat/completions
LOCAL_LLM_MODEL=llama3.2:3b
# To use Gemini, set AI_PROVIDER=gemini and configure both values below.
GEMINI_API_KEY=
GEMINI_MODEL=
# To use ChatGPT through the OpenAI API, set AI_PROVIDER=chatgpt (or openai) and configure both values below.
OPENAI_API_KEY=
OPENAI_MODEL=
# ACTIVE_HOURS=08:30-22:00
# Equal start and end (09:00-09:00) keeps the bot always active.
STATUS_LANGUAGE=en
# DISCOVERY_KEYWORDS=opensource,elixir,linux

# Login entryway only. After session create, com.atproto.* uses the account PDS
# from the DID document; app.bsky.* (feeds, search, notifications) uses
# https://public.api.bsky.app. Do not set this to the AppView.
BLUESKY_PDS_URL=https://bsky.social
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# Bluesky listen/start use Jetstream automatically. --jetstream is a compatibility no-op.
# Current Jetstream JSON API; WSS only, no credentials or query parameters.
# BLUESKY_JETSTREAM_URL=wss://jetstream.us-east.bsky.network
